{
  "name": "genganote",
  "version": "1.0.0",
  "description": "Always-on-top Windows desktop mascot that turns your Granola meeting notes into a prioritized to-do list with the Claude Code CLI, and files everything into your Obsidian second brain.",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "keywords": [
    "electron",
    "windows",
    "desktop-widget",
    "todo",
    "productivity",
    "granola",
    "meeting-notes",
    "claude",
    "claude-code",
    "obsidian",
    "second-brain",
    "whisper",
    "transcription"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "electron .",
    "sync": "node src/cli-sync.js"
  },
  "devDependencies": {
    "electron": "^33.2.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "ffmpeg-static": "^5.3.0"
  },
  "author": "Giovanni Cornacchia",
  "repository": {
    "type": "git",
    "url": "https://github.com/GioCorna97/genganote.git"
  },
  "homepage": "https://github.com/GioCorna97/genganote#readme",
  "bugs": {
    "url": "https://github.com/GioCorna97/genganote/issues"
  }
}
